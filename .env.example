# Copy to .env and adjust. Never commit .env.

# --- API ---
DATABASE_URL=postgres://tinycloud:tinycloud@127.0.0.1:5433/tinycloud?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Optional bootstrap administrator. Leave both empty to use the /setup screen
# on first run instead of seeding an account.
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=TinyCloud Admin
ADMIN_PASSWORD=

# --- Host stats (60s sampling, 90 day retention) ---
STATS_INTERVAL=60s
STATS_RETENTION_DAYS=90
HOST_PROC=/proc
HOST_ROOT=/

# --- Postgres pool ---
PG_POOL_MAX=10
PG_POOL_MIN=2
PG_POOL_MAX_LIFETIME=30m
PG_POOL_MAX_IDLE=5m
PG_POOL_HEALTH_PERIOD=30s
PG_CONNECT_TIMEOUT=10s

# --- Frontend ---
# Same-origin /api proxy target used by next.config.ts rewrites.
API_PROXY_TARGET=http://127.0.0.1:5950
